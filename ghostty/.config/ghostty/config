font-family = IosevkaTerm Nerd Font Mono
font-style = Medium
font-size = 16
theme = light:Bluloco Light,dark:Bluloco Dark
bold-is-bright = true
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
confirm-close-surface = false
macos-option-as-alt = left
background-opacity = 0.9 
background-blur = 30
# "tabs" hides the tab bar on macOS 27, change back to tabs when 1.4.0 released
macos-titlebar-style = transparent
initial-window = true
window-position-x = 0
window-position-y = 0
window-height = 70
window-width = 320
