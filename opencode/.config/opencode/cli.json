{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "bluloco"
  },
  "keybinds": {
    "leader": "ctrl+l"
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "notifications": false,
    "sound": false
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "status"
  },
  "terminal": {
    "copy": "select"
  }
}
