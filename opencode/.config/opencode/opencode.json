{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pub", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "shell", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "shell", "resource": "*.pem*", "effect": "deny" },
    { "action": "shell", "resource": "*.p12*", "effect": "deny" },
    { "action": "shell", "resource": "*.env.example*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/Source/_freelance/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.dotfiles/nvim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/nvim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/nvim/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Source/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/opt/homebrew/Cellar/neovim/*",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote@latest",
          "https://mcp.atlassian.com/v1/mcp"
        ],
        "disabled": true
      },
      "gitlab": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote@latest",
          "https://gitlab.boxine.de/api/v4/mcp"
        ],
        "disabled": true
      },
      "configcat": {
        "type": "local",
        "command": ["npx", "-y", "@configcat/mcp-server"],
        "disabled": true
      },
      "figma": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "disabled": true
      },
      "bitrise": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote@latest",
          "https://mcp.bitrise.io",
          "--header",
          "Authorization: Bearer {env:BITRISE_TOKEN}"
        ],
        "disabled": true
      },
      "sentry": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@sentry/mcp-server@latest",
          "--host=sentry-2.boxine.de",
          "--disable-skills=seer",
          "--access-token={env:SENTRY_MCP_TOKEN}"
        ],
        "disabled": true
      },
      "mobile-mcp": {
        "type": "local",
        "command": ["npx", "@mobilenext/mobile-mcp@latest"],
        "disabled": true
      },
      "metro-mcp": {
        "type": "local",
        "command": ["npx", "-y", "metro-mcp"],
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      },
      "vscode-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "http://127.0.0.1:9222"
        ],
        "disabled": true
      }
    }
  },
  "disabled_providers": ["amazon-bedrock"],
  "providers": {
    "bedrock": {
      "name": "Bedrock",
      "canonical": "amazon-bedrock",
      "settings": {
        "region": "eu-central-1",
        "profile": "bedrock"
      },
      "models": {
        "claude-opus-5": {
          "modelID": "arn:aws:bedrock:eu-central-1:802320708029:application-inference-profile/96navruut07b",
          "name": "Claude Opus 5",
          "cost": {
            "input": 5,
            "output": 25,
